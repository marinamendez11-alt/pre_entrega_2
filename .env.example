# Proveedor de LLM a usar: openai / anthropic / google
LLM_PROVIDER=google

# --- Google Gemini (proveedor por defecto) ---
GOOGLE_API_KEY=api-key-de-google-aca
GOOGLE_MODEL=gemini-flash-latest

